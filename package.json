{
  "name": "mack",
  "version": "0.1.0",
  "description": "A desktop math-research harness: open models propose, Lean decides. Modelled on Open Math Harness.",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "setup:lean": "powershell -ExecutionPolicy Bypass -File scripts/setup-lean.ps1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
